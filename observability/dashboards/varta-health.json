{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping varta-watch /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Varta health observer — beat ingest, observer iteration latency, recovery, capacity, security. Pairs with observability/alerts/varta.rules.yml and observability/recording-rules/varta.rules.yml.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "tags": [],
      "targetBlank": true,
      "title": "Varta runbook",
      "type": "link",
      "url": "https://github.com/aramirez087/Varta/blob/main/book/src/operations/monitoring.md"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Observer uptime",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "targets": [
        { "expr": "varta_watch_uptime_seconds", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Agents tracked",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "targets": [
        { "expr": "varta_watch_pids_tracked", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Beats / sec",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "targets": [
        { "expr": "varta:beats:rate_1m", "legendFormat": "beats/s", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Tracker utilisation",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "targets": [
        { "expr": "varta:tracker:utilization", "legendFormat": "{{instance}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "showThresholdLabels": false, "showThresholdMarkers": true }
    },

    {
      "id": 101,
      "type": "row",
      "title": "Beat path",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Beats / sec (total)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(varta_beats_total[1m]))", "legendFormat": "beats", "refId": "A" },
        { "expr": "sum(rate(varta_stalls_total[5m]))", "legendFormat": "stalls", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Beat-path latency (iteration − scrape)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Derived from iteration histogram minus scrape histogram. Recording rule varta:beat_path_seconds:p99_5m. Alert: VartaBeatPathP99High.",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "targets": [
        { "expr": "varta:iteration_seconds:p50_5m", "legendFormat": "iteration p50", "refId": "A" },
        { "expr": "varta:iteration_seconds:p99_5m", "legendFormat": "iteration p99", "refId": "B" },
        { "expr": "varta:beat_path_seconds:p99_5m", "legendFormat": "beat-path p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 0 } }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Decode errors by kind",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 6 },
      "targets": [
        { "expr": "varta:decode_errors:rate_5m", "legendFormat": "{{kind}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },

    {
      "id": 102,
      "type": "row",
      "title": "Observer iteration",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Iteration latency p50 / p99 / p999",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "targets": [
        { "expr": "varta:iteration_seconds:p50_5m", "legendFormat": "p50", "refId": "A" },
        { "expr": "varta:iteration_seconds:p99_5m", "legendFormat": "p99", "refId": "B" },
        { "expr": "varta:iteration_seconds:p999_5m", "legendFormat": "p99.9", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Per-stage p99 latency",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Stages: drain_pending, poll, maintenance, recovery_reap, serve_pending, idle, housekeeping.",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "targets": [
        { "expr": "varta:stage_seconds:p99_5m", "legendFormat": "{{stage}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 0, "stacking": { "mode": "none" } } }, "overrides": [] }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Iteration budget overruns",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 29, "w": 12, "h": 6 },
      "targets": [
        { "expr": "rate(varta_observer_iteration_budget_exceeded_total[5m])", "legendFormat": "iter budget exceeded /s", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars" } }, "overrides": [] }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Scrape budget overruns",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 29, "w": 12, "h": 6 },
      "targets": [
        { "expr": "rate(varta_observer_scrape_budget_exceeded_total[5m])", "legendFormat": "scrape budget exceeded /s", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars" } }, "overrides": [] }
    },

    {
      "id": 103,
      "type": "row",
      "title": "Recovery",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 35, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Recovery outcomes by outcome label",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "targets": [
        { "expr": "varta:recovery_outcomes:rate_5m", "legendFormat": "{{outcome}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Recovery duration (mean)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "targets": [
        { "expr": "varta:recovery_duration_seconds:mean_5m", "legendFormat": "mean", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] }
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Recovery refusals by reason",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 44, "w": 12, "h": 8 },
      "targets": [
        { "expr": "varta:recovery_refused:rate_5m", "legendFormat": "{{reason}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Audit fsync p99 + ring watermark events",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 44, "w": 12, "h": 8 },
      "targets": [
        { "expr": "varta:audit_fsync_seconds:p99_5m", "legendFormat": "fsync p99", "refId": "A" },
        { "expr": "rate(varta_audit_ring_watermark_total[5m])", "legendFormat": "watermark {{level}}/s", "refId": "B" },
        { "expr": "rate(varta_recovery_audit_dropped_total[5m])", "legendFormat": "audit drops/s", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 0 } }, "overrides": [] }
    },

    {
      "id": 104,
      "type": "row",
      "title": "Capacity & sharding",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 52, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "Tracker utilisation over time",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 53, "w": 12, "h": 8 },
      "targets": [
        { "expr": "varta:tracker:utilization", "legendFormat": "utilisation", "refId": "A" },
        { "expr": "rate(varta_tracker_evicted_total[5m])", "legendFormat": "evicted/s", "refId": "B" },
        { "expr": "rate(varta_tracker_eviction_scan_truncated_total[5m])", "legendFormat": "eviction truncated/s", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 0 } }, "overrides": [] }
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Probe exhaustion (tracker / outstanding / ip-state)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 53, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(varta_tracker_pid_index_probe_exhausted_total[5m])", "legendFormat": "tracker pid_index", "refId": "A" },
        { "expr": "rate(varta_recovery_outstanding_probe_exhausted_total[5m])", "legendFormat": "outstanding", "refId": "B" },
        { "expr": "rate(varta_prom_ip_state_probe_exhausted_total[5m])", "legendFormat": "ip_state", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 70 } }, "overrides": [] }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Rate-limit drops by reason",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 61, "w": 12, "h": 8 },
      "targets": [
        { "expr": "varta:rate_limited:rate_5m", "legendFormat": "{{reason}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "Cross-namespace conflicts",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 61, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(varta_tracker_namespace_conflict_total[5m])", "legendFormat": "tracker NS conflict/s", "refId": "A" },
        { "expr": "rate(varta_frame_namespace_mismatch_total[5m])", "legendFormat": "frame NS mismatch/s", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 60 } }, "overrides": [] }
    },

    {
      "id": 105,
      "type": "row",
      "title": "Security & integrity",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 69, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 50,
      "type": "stat",
      "title": "Bearer-token auth failures /s",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 70, "w": 8, "h": 6 },
      "targets": [
        { "expr": "rate(varta_prom_auth_failures_total[5m])", "legendFormat": "auth failures/s", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 51,
      "type": "stat",
      "title": "Frame auth failures /s",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 8, "y": 70, "w": 8, "h": 6 },
      "targets": [
        { "expr": "rate(varta_frame_auth_failures_total[5m])", "legendFormat": "frame auth failures/s", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.01 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 52,
      "type": "stat",
      "title": "Frame decrypt failures /s",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 16, "y": 70, "w": 8, "h": 6 },
      "targets": [
        { "expr": "rate(varta_frame_decrypt_failures_total[5m])", "legendFormat": "decrypt failures/s", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.01 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 53,
      "type": "timeseries",
      "title": "Secure-UDP AEAD attempts ratio",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "In steady state == keys_loaded (constant-trial AEAD poll closes the key-rotation timing channel). Deviation -> a key was rotated or the invariant is broken.",
      "gridPos": { "x": 0, "y": 76, "w": 12, "h": 6 },
      "targets": [
        { "expr": "varta:secure_aead_attempts:ratio_5m", "legendFormat": "attempts / beat", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 0 } }, "overrides": [] }
    },
    {
      "id": 54,
      "type": "timeseries",
      "title": "Status mix",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "varta_status: 0=Ok, 1=Degraded, 2=Critical, 3=Stall. Shows the last-reported status across tracked agents.",
      "gridPos": { "x": 12, "y": 76, "w": 12, "h": 6 },
      "targets": [
        { "expr": "count by (instance) (varta_status == 0)", "legendFormat": "Ok", "refId": "A" },
        { "expr": "count by (instance) (varta_status == 1)", "legendFormat": "Degraded", "refId": "B" },
        { "expr": "count by (instance) (varta_status == 2)", "legendFormat": "Critical", "refId": "C" },
        { "expr": "count by (instance) (varta_status == 3)", "legendFormat": "Stall", "refId": "D" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 70 } }, "overrides": [] }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["varta", "observability", "prometheus"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "${DS_PROMETHEUS}" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Varta — observer health",
  "uid": "varta-health",
  "version": 1,
  "weekStart": ""
}
